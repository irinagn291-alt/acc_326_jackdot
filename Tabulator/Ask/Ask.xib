                            <state key="normal" title="Tie"/>
                            <connections>
                                <action selector="tieTapped" destination="-1" eventType="touchUpInside" id="at"/>
                            </connections>
                        </button>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="" lineBreakMode="wordWrap" numberOfLines="2" translatesAutoresizingMaskIntoConstraints="NO" id="spar">
                            <rect key="frame" x="16" y="228" width="326" height="0"/>
                            <fontDescription key="fontDescription" type="system" pointSize="15"/>
                        </label>
                        <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" style="plain" separatorStyle="none" rowHeight="-1" estimatedRowHeight="88" translatesAutoresizingMaskIntoConstraints="NO" id="table">
                            <rect key="frame" x="16" y="236" width="326" height="380"/>
                        </tableView>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="peel" customClass="PressButton" customModule="Tabulator" customModuleProvider="target">
                            <rect key="frame" x="16" y="624" width="326" height="44"/>
                            <constraints>
