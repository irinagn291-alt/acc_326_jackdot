                        <constraint firstItem="retry" firstAttribute="leading" secondItem="error" secondAttribute="leading" constant="16" id="x7"/>
                        <constraint firstAttribute="trailing" secondItem="retry" secondAttribute="trailing" constant="16" id="x8"/>
                        <constraint firstAttribute="bottom" secondItem="retry" secondAttribute="bottom" constant="16" id="x9"/>
                    </constraints>
                </view>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe"/>
            <color key="backgroundColor" white="0.06" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
