                        <constraint firstItem="table" firstAttribute="leading" secondItem="status" secondAttribute="leading" id="c19"/>
                        <constraint firstItem="table" firstAttribute="trailing" secondItem="status" secondAttribute="trailing" id="c20"/>
                        <constraint firstItem="table" firstAttribute="top" secondItem="spar" secondAttribute="bottom" constant="8" id="c21"/>
                        <constraint firstItem="peel" firstAttribute="leading" secondItem="status" secondAttribute="leading" id="c22"/>
                        <constraint firstItem="peel" firstAttribute="trailing" secondItem="status" secondAttribute="trailing" id="c23"/>
                        <constraint firstItem="peel" firstAttribute="top" secondItem="table" secondAttribute="bottom" constant="8" id="c24"/>
                        <constraint firstItem="read" firstAttribute="leading" secondItem="status" secondAttribute="leading" id="c25"/>
                        <constraint firstItem="read" firstAttribute="trailing" secondItem="status" secondAttribute="trailing" id="c26"/>
                        <constraint firstItem="read" firstAttribute="top" secondItem="peel" secondAttribute="bottom" constant="8" id="c27"/>
                        <constraint firstAttribute="bottom" secondItem="read" secondAttribute="bottom" constant="16" id="c28"/>
                    </constraints>
                </view>
                <view hidden="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="empty">
