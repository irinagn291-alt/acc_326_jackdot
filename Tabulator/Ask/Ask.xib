                    <subviews>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Card is blank" lineBreakMode="wordWrap" numberOfLines="2" translatesAutoresizingMaskIntoConstraints="NO" id="etitle">
