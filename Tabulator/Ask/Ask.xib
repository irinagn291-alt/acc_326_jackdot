                            <fontDescription key="fontDescription" type="system" pointSize="17"/>
                        </label>
                        <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="center" placeholder="Type a name" translatesAutoresizingMaskIntoConstraints="NO" id="field">
