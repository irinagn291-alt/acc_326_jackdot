                        <constraint firstAttribute="trailing" secondItem="xtitle" secondAttribute="trailing" constant="16" id="x2"/>
                        <constraint firstItem="xtitle" firstAttribute="top" secondItem="error" secondAttribute="top" constant="80" id="x3"/>
