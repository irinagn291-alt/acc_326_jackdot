                <outlet property="hintLabel" destination="hint" id="oh"/>
                <outlet property="historyButton" destination="hist" id="ohi"/>
                <outlet property="nameField" destination="field" id="of"/>
                <outlet property="peelButton" destination="peel" id="op"/>
                <outlet property="plateView" destination="plate" id="opl"/>
                <outlet property="readButton" destination="read" id="ord"/>
                <outlet property="settingsButton" destination="gear" id="osg"/>
                <outlet property="sparLabel" destination="spar" id="os"/>
                <outlet property="statusLabel" destination="status" id="ost"/>
                <outlet property="tableView" destination="table" id="otb"/>
                <outlet property="tieButton" destination="tie" id="oti"/>
                <outlet property="view" destination="root" id="ov"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <visualEffectView opaque="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="blur">
                    <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
                    <view key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" insetsLayoutMarginsFromSafeArea="NO" id="blurContent">
                        <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    </view>
                    <blurEffect style="systemThinMaterialDark"/>
                </visualEffectView>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="plate" customClass="AskPlateView" customModule="Tabulator" customModuleProvider="target">
                    <rect key="frame" x="16" y="75" width="358" height="735"/>
                    <subviews>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="hist">
                            <rect key="frame" x="16" y="16" width="88" height="44"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="44" id="hh"/>
                            </constraints>
                            <state key="normal" title="History"/>
                            <connections>
                                <action selector="historyTapped" destination="-1" eventType="touchUpInside" id="ah"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="gear">
                            <rect key="frame" x="254" y="16" width="88" height="44"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="44" id="gh"/>
                            </constraints>
                            <state key="normal" title="Settings"/>
                            <connections>
                                <action selector="settingsTapped" destination="-1" eventType="touchUpInside" id="ag"/>
                            </connections>
                        </button>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Punched" lineBreakMode="tailTruncation" numberOfLines="2" translatesAutoresizingMaskIntoConstraints="NO" id="status">
