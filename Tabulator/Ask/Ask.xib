                            <constraints>
                                <constraint firstAttribute="height" constant="48" id="xh"/>
                            </constraints>
                            <state key="normal" title="Start blank"/>
                            <connections>
                                <action selector="errorRetryTapped" destination="-1" eventType="touchUpInside" id="ax"/>
                            </connections>
                        </button>
