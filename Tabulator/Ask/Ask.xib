                            <fontDescription key="fontDescription" name="Impact" family="Impact" pointSize="36"/>
                        </label>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Stored card could not be read." lineBreakMode="wordWrap" numberOfLines="4" translatesAutoresizingMaskIntoConstraints="NO" id="xline">
                            <rect key="frame" x="16" y="136" width="358" height="24"/>
                            <fontDescription key="fontDescription" type="system" pointSize="17"/>
